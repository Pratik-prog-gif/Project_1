# The bronze loader uses LINES TERMINATED BY '\r\n', so the source CSVs must
# keep their CRLF endings byte-for-byte on every platform. Without this,
# core.autocrlf would normalise them to LF on commit and a Linux clone would
# get LF files that the loader cannot parse.
dataset/**/*.csv -text

# Everything else is normal text: LF in the repository, native in the checkout.
*.sql   text
*.md    text
*.txt   text
*.ps1   text eol=crlf

# Count SQL in the repository language statistics.
#
# GitHub Linguist classifies plain "SQL" as type: data, and data languages are
# excluded from the language bar by default. (T-SQL and PL/pgSQL are type:
# programming, which is why a SQL Server project shows up as TSQL while a
# MySQL project shows nothing at all.) Without this, the 40 KB of SQL that IS
# the project is invisible and the 3 KB PowerShell helper reads as 100% of it.
*.sql   linguist-detectable=true
